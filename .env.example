# ═══════════════════════════════════════════════════════════════
#  Copia este archivo como  .env  y rellena los valores.
#  .env NUNCA se sube a git (ya está en .gitignore).
# ═══════════════════════════════════════════════════════════════

# ─── Neon PostgreSQL ────────────────────────────────────────────
# Neon Console → tu proyecto → botón "Connect".
# Usa una base EXCLUSIVA para el portafolio (p. ej. /portafolio): si otra app con
# Prisma comparte la misma base, sus migraciones borrarán estas tablas.
# DATABASE_URL: cadena con "Connection pooling" ACTIVADO (host con -pooler).
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: la MISMA cadena con "Connection pooling" DESACTIVADO (sin -pooler).
# La usa Prisma para las migraciones.
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Cloudflare R2 ──────────────────────────────────────────────
# Dashboard de Cloudflare → R2 Object Storage.
CLOUDFLARE_ACCOUNT_ID=""
# R2 → "Manage API tokens" → Create API token (permiso: Object Read & Write).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública del bucket, SIN barra final:
#   https://pub-xxxxxxxxxxxxxxxx.r2.dev   (Settings → Public Development URL)
#   https://cdn.tudominio.com             (Settings → Custom Domains)
R2_PUBLIC_URL=""

# ─── Panel de administración (/admin) ───────────────────────────
# PIN o contraseña (mínimo 4 caracteres; se aceptan letras y símbolos).
ADMIN_PIN=""
# Cadena aleatoria larga para firmar la sesión. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ─── Servidor ───────────────────────────────────────────────────
PORT=3001
# NO definas NODE_ENV aquí: Vite lo lee del .env y "npm run build" generaría
# una versión de desarrollo. En producción, NODE_ENV=production se configura
# en las variables del hosting (Render, Railway…).
