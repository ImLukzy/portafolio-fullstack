{
  "name": "portafolio-lukas",
  "private": true,
  "version": "1.0.0",
  "description": "Portafolio de Lukas Melgar Casimiro: SPA pública + CMS privado (/admin) sobre Neon PostgreSQL y Cloudflare R2.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.js",
    "build": "prisma generate && vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:reset": "node prisma/seed.js --reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.2",
    "multer": "^2.4.0",
    "prisma": "7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "simple-icons": "^16.32.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
